#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *file;
    int id;
    char name[100];
    char section[50];
    int choice;

    do {
        file = fopen("student_records.txt", "a");
        if (file == NULL) {
            printf("Error opening file!\n");
            return 1;
        }
        printf("Enter Student Number: ");
        scanf("%d", &id);
        while (getchar() != '\n');

        printf("Enter Complete Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = 0;

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = 0;

        fprintf(file, "ID Number: %d\n", id);
        fprintf(file, "Complete Name: %s\n", name);
        fprintf(file, "Section: %s\n\n", section);

        fclose(file);

        printf("\nRecord added and saved successfully.\n\n");

        printf("Add another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);
        printf("\n");

    } while (choice == 1);

    printf("All student records have been saved.\n");

    return 0;
}